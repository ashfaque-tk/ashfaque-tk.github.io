---
import projectsFile from '../data/projects.json';
import { augmentProjectsWithImages, type ProjectEntry, type ProjectSection } from '../lib/fetchGitHub';
import { withBase, withBaseList } from '../lib/assetPath';
import { icons } from '../lib/icons';

interface Props {
  featuredOnly?: boolean;
}
const { featuredOnly = false } = Astro.props;

type Entry = ProjectEntry & { covers: string[]; images: string[] };

const augmented = (await augmentProjectsWithImages(
  projectsFile.items as unknown as ProjectEntry[]
)) as ProjectEntry[];

/** `cover` may be one path or a list; the card uses the first as its backdrop. */
const entries: Entry[] = augmented.map((p) => ({
  ...p,
  covers: withBaseList(
    (Array.isArray(p.cover) && p.cover.length ? p.cover : p.cover) ||
      p.backgroundImage ||
      p.featuredImage
  ),
  images: withBaseList(p.images),
}));

const allProjectsData = featuredOnly ? entries.filter((p) => p.covers.length) : entries;

/** Normalises one write-up block. `image` is an optional figure rendered under the text. */
function norm(section: ProjectSection | undefined) {
  const s = section ?? {};
  return {
    text: (s.text ?? '').trim(),
    items: (s.items ?? []).map((i) => i.trim()).filter(Boolean),
    image: s.image ? withBase(s.image) : '',
  };
}

const hasContent = (s: { text: string; items: string[]; image: string }) =>
  Boolean(s.text || s.items.length || s.image);

type ModalLink = { label: string; href: string; icon: string; primary: boolean };

/** Builds the modal payload: a fixed Problem -> optional Solution -> optional Decisions -> Results flow. */
function toModal(entry: Entry) {
  // Problem and Results always carry a fixed heading. Optional sections only appear
  // when projects.json supplies both an explicit title and some content.
  const fixed = [
    { heading: 'The Problem', ...norm(entry.problem) },
    { heading: 'The Results', ...norm(entry.results) },
  ].filter(hasContent);
  const optional = [entry.solution, entry.decisions]
    .map((s) => ({ heading: s?.title?.trim() ?? '', ...norm(s) }))
    .filter((s) => s.heading && hasContent(s));

  const problem = fixed[0];
  const results = fixed[1];
  const sections = [
    ...(problem ? [problem] : []),
    ...optional,
    ...(results ? [results] : []),
  ];

  const code = entry.links?.code ?? entry.githubRepo;
  const links: ModalLink[] = [];
  if (code) links.push({ label: 'Code', href: code, icon: 'code-bracket', primary: false });
  if (entry.links?.read)
    links.push({ label: 'Read', href: entry.links.read, icon: 'book-open', primary: false });
  if (entry.links?.app)
    links.push({
      label: 'Dashboard',
      href: entry.links.app,
      icon: 'arrow-right-circle',
      primary: true,
    });
  // Fallback for entries that still only carry a single `link`.
  if (!links.length && entry.link)
    links.push({ label: 'Open', href: entry.link, icon: 'arrow-right-circle', primary: true });

  return { sections, links };
}

const projects = allProjectsData.map((p, i) => ({
  ...p,
  id: `project-${i}`,
  cover: p.covers[0] ?? '',
  images: p.images,
  ...toModal(p),
}));

const categoryFilters = [
  ...new Set(allProjectsData.map((p) => p.category).filter(Boolean)),
].map((cat) => ({ label: cat.replace(/\b\w/g, (c) => c.toUpperCase()), value: cat }));

const filters = [
  { label: 'Featured', value: 'featured' },
  { label: 'All', value: 'all' },
  ...categoryFilters,
];

const projectsJson = JSON.stringify(projects);
const iconPaths = JSON.stringify(icons);
---

<section
  id="projects"
  class="py-24"
  style="scroll-margin-top: 80px; background: #ffffff;"
>
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-10 reveal">
      <p class="text-sm font-semibold tracking-widest text-highlight uppercase mb-3">My work</p>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold section-title">Featured Projects</h2>
    </div>

    <div class="flex flex-wrap justify-center gap-2 mb-10 reveal" style="transition-delay: 0.1s;">
      {
        filters.map((f) => (
          <button class="filter-btn" data-filter={f.value} aria-pressed={f.value === 'featured' ? 'true' : 'false'}>
            {f.label}
            <span class="filter-count" data-count={f.value} />
          </button>
        ))
      }
    </div>

    <div
      id="projects-grid"
      class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"
    >
      {
        projects.map((project, i) => (
          <div
            class={`project-card reveal${project.cover ? ' has-bg' : ''}`}
            data-category={project.category}
            data-featured={String(Boolean(project.featured))}
            data-id={project.id}
            data-index={i}
            style={`transition-delay: ${(i % 3) * 0.07}s;`}
            role="button"
            tabindex="0"
            aria-label={`Open details for ${project.title}`}
          >
            {project.colorIcon && (
              <div class="float-icon-wrap" aria-hidden="true">
                <img
                  src={withBase(
                    project.colorIcon.includes(':')
                      ? `/images/icons/${project.colorIcon.replace(':', '/')}.svg`
                      : project.colorIcon
                  )}
                  alt=""
                  class="float-icon"
                  loading="lazy"
                  width="44"
                  height="44"
                />
              </div>
            )}

            <div class="project-card-inner">
              {project.cover && (
                <div class="card-bg-img" aria-hidden="true">
                  <img src={project.cover} alt="" loading="lazy" width="600" height="400" />
                </div>
              )}

              <div class="p-5 flex flex-col flex-1 relative z-10">
                <p class="text-xs font-bold text-highlight uppercase tracking-widest leading-tight mb-3">
                  {project.company}
                </p>
                <h3 class="project-title text-lg font-bold mb-2 leading-snug">{project.title}</h3>
                <p class="card-desc text-sm leading-relaxed flex-1 mb-4">{project.summary}</p>
                <div class="flex flex-wrap gap-1.5">
                  {project.tags.map((tag) => (
                    <span class="tag">{tag}</span>
                  ))}
                </div>
              </div>

              <div class="project-footer relative z-10">
                <span class="category-badge">{project.category}</span>
                {project.icon && icons[project.icon] && (
                  <div class="card-icon shrink-0">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke-width="1.5"
                      stroke="currentColor"
                      class="w-5 h-5"
                      set:html={icons[project.icon]}
                    />
                  </div>
                )}
                <span class="view-hint">
                  <span class="view-hint-text">View details</span>
                  <svg
                    class="view-hint-arrow"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"
                    />
                  </svg>
                </span>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <p id="projects-empty" class="hidden text-center text-slate-600 text-sm mt-12">
      No projects in this category yet.
    </p>
  </div>
</section>

<div
  id="project-modal"
  class="modal-backdrop"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-title"
  hidden
>
  <div class="modal-container" id="modal-container">
    <button class="modal-close" id="modal-close" aria-label="Close">
      <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-5 h-5">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"
        ></path>
      </svg>
    </button>

    <div class="modal-header-block">
      <div class="modal-eyebrow">
        <span id="modal-category-badge" class="modal-cat-badge"></span>
        <span id="modal-company" class="modal-company"></span>
      </div>
      <h2 id="modal-title" class="modal-heading"></h2>
    </div>

    <div class="modal-body-scroll" id="modal-sections"></div>

    <div class="modal-section modal-section--tags">
      <h3 class="section-subheading">Built with</h3>
      <div id="modal-tags" class="modal-tags"></div>
    </div>

    <div class="modal-footer-bar" id="modal-links"></div>
  </div>
</div>

<script is:inline define:vars={{ projectsJson, iconPaths }}>
  const projects = JSON.parse(projectsJson);
  const ICONS = JSON.parse(iconPaths);
  const $ = (id) => document.getElementById(id);

  /** Escapes HTML, then applies the tiny markdown subset used in projects.json. */
  const md = (raw) =>
    raw
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
      .replace(/(^|[^*])\*([^*]+?)\*(?!\*)/g, '$1<em>$2</em>')
      .replace(/`(.+?)`/g, '<code>$1</code>');

  const el = (tag, cls, html) => {
    const n = document.createElement(tag);
    if (cls) n.className = cls;
    if (html != null) n.innerHTML = html;
    return n;
  };

  document.querySelectorAll('#projects .reveal').forEach((node) => {
    const io = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          node.classList.add('visible');
          io.disconnect();
        }
      },
      { threshold: 0.05 }
    );
    io.observe(node);
  });

  /* ---------- filters ---------- */
  const filterBtns = document.querySelectorAll('.filter-btn');
  const cards = document.querySelectorAll('.project-card[data-category]');
  const empty = $('projects-empty');
  let active = null;

  document.querySelectorAll('.filter-count').forEach((node) => {
    const cat = node.dataset.count;
    const n =
      cat === 'all'
        ? cards.length
        : cat === 'featured'
          ? [...cards].filter((c) => c.dataset.featured === 'true').length
          : [...cards].filter((c) => c.dataset.category === cat).length;
    node.textContent = String(n);
  });

  function applyFilter(filter) {
    if (filter === active) return;
    active = filter;
    filterBtns.forEach((b) => {
      const on = b.dataset.filter === filter;
      b.classList.toggle('filter-active', on);
      b.setAttribute('aria-pressed', String(on));
    });
    let visible = 0;
    cards.forEach((card) => {
      const match =
        filter === 'all' ||
        (filter === 'featured' && card.dataset.featured === 'true') ||
        card.dataset.category === filter;
      card.classList.remove('pf-enter');
      if (!match) {
        card.classList.add('pf-hidden');
      } else {
        card.classList.remove('pf-hidden');
        card.style.setProperty('--enter-delay', `${visible * 0.05}s`);
        void card.offsetWidth;
        card.classList.add('pf-enter');
        visible++;
      }
    });
    if (empty) empty.classList.toggle('hidden', visible > 0);
  }

  filterBtns.forEach((btn) => btn.addEventListener('click', () => applyFilter(btn.dataset.filter)));
  applyFilter('featured');

  /* ---------- modal ---------- */
  const modal = $('project-modal');
  const container = $('modal-container');
  const closeBtn = $('modal-close');
  const sectionsHost = $('modal-sections');
  const linksHost = $('modal-links');
  let lastFocused = null;

  function renderSection(section) {
    const wrap = el('section', 'modal-section');
    wrap.append(el('h3', 'section-subheading', md(section.heading)));
    if (section.text) wrap.append(el('p', 'modal-prose', md(section.text)));
    if (section.items.length) {
      const ul = el('ul', 'modal-bullet-list');
      section.items.forEach((item) => ul.append(el('li', null, md(item))));
      wrap.append(ul);
    }
    if (section.image) {
      const fig = el('figure', 'modal-figure');
      const img = el('img', 'modal-figure-img');
      img.src = section.image;
      img.alt = `${section.heading} — figure`;
      img.loading = 'lazy';
      fig.append(img);
      fig.append(el('figcaption', 'modal-figure-cap', 'Click to view full size'));
      wrap.append(fig);
    }
    return wrap;
  }

  function renderLink(link) {
    const a = el('a', `modal-btn${link.primary ? ' modal-btn--primary' : ''}`);
    a.href = link.href;
    a.target = '_blank';
    a.rel = 'noopener';
    const path = ICONS[link.icon];
    if (path) {
      const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
      svg.setAttribute('viewBox', '0 0 24 24');
      svg.setAttribute('fill', 'none');
      svg.setAttribute('stroke', 'currentColor');
      svg.setAttribute('stroke-width', '1.5');
      svg.setAttribute('class', 'modal-btn-icon');
      svg.innerHTML = path;
      a.append(svg);
    }
    a.append(document.createTextNode(link.label));
    return a;
  }

  function openModal(id) {
    const p = projects.find((item) => item.id === id);
    if (!p) return;
    lastFocused = document.activeElement;

    $('modal-title').textContent = p.title;
    $('modal-company').textContent = p.company || '';
    $('modal-category-badge').textContent = p.category || '';
    $('modal-category-badge').classList.toggle('hidden', !p.category);

    sectionsHost.replaceChildren(...p.sections.map(renderSection));

    $('modal-tags').replaceChildren(
      ...p.tags.map((t) => {
        const s = document.createElement('span');
        s.className = 'tag';
        s.textContent = t;
        return s;
      })
    );

    linksHost.replaceChildren(...p.links.map(renderLink));
    linksHost.classList.toggle('hidden', p.links.length === 0);

    modal.removeAttribute('hidden');
    document.body.style.overflow = 'hidden';
    void container.offsetWidth;
    modal.classList.add('modal-open');
    closeBtn.focus();
  }

  function closeModal() {
    modal.classList.remove('modal-open');
    modal.classList.add('modal-closing');
    setTimeout(() => {
      modal.setAttribute('hidden', '');
      modal.classList.remove('modal-closing');
      document.body.style.overflow = '';
      if (lastFocused && typeof lastFocused.focus === 'function') lastFocused.focus();
    }, 280);
  }

  cards.forEach((card) => {
    card.addEventListener('click', () => openModal(card.dataset.id));
    card.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        openModal(card.dataset.id);
      }
    });
  });

  // Full-size figure: clicking a section image opens it in a new tab.
  sectionsHost.addEventListener('click', (e) => {
    const img = e.target.closest('.modal-figure-img');
    if (img?.src) window.open(img.src, '_blank', 'noopener');
  });

  closeBtn.addEventListener('click', closeModal);
  modal.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !modal.hasAttribute('hidden')) closeModal();
  });
</script>

<style is:global>
  /* ---------- filter pills ---------- */
  .filter-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 1rem;
    border-radius: 9999px;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--text-dim);
    background: var(--bg-section);
    border: 1px solid var(--border);
    cursor: pointer;
  }
  .filter-btn:hover {
    color: var(--text-muted);
    background: var(--bg-card);
    border-color: var(--border-hover);
    transform: translateY(-1px);
  }
  .filter-btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .filter-btn.filter-active {
    color: var(--accent);
    background: var(--pg-accent-soft);
    border-color: var(--pg-accent-line);
  }
  .filter-count {
    font-size: 0.65rem;
    font-weight: 700;
    color: var(--text-dimmer);
    background: var(--border);
    border-radius: 9999px;
    padding: 0 0.35rem;
    min-width: 1.1rem;
    text-align: center;
  }
  .filter-btn.filter-active .filter-count {
    color: var(--accent);
    background: var(--pg-accent-line);
  }

  /* ---------- card ---------- */
  .project-card {
    position: relative;
    cursor: pointer;
    transition: opacity 0.2s ease;
  }
  .project-card:focus-visible .project-card-inner {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .project-card.pf-hidden {
    display: none;
  }
  .project-card.pf-enter {
    animation: card-enter 0.4s cubic-bezier(0.22, 1, 0.36, 1) var(--enter-delay, 0s) both;
  }
  @keyframes card-enter {
    from {
      opacity: 0;
      transform: translateY(18px) scale(0.97);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .project-card-inner {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    border-radius: 1rem;
    border: 1px solid var(--border);
    background: #ffffff;
    box-shadow: var(--pg-shadow-card);
    overflow: hidden;
  }
  .project-card:hover .project-card-inner {
    transform: translateY(-5px);
    border-color: var(--pg-accent-line);
    box-shadow: var(--pg-shadow-hover);
  }

  .project-title {
    color: var(--text);
    transition: color 0.35s ease;
  }
  .project-card:hover .project-title {
    color: var(--accent);
  }
  .card-desc {
    color: var(--text-muted);
  }
  .card-icon {
    color: var(--pg-accent-soft);
    transition: color 0.35s ease;
  }

  .float-icon-wrap {
    position: absolute;
    top: -14px;
    right: 16px;
    z-index: 20;
    width: 44px;
    height: 44px;
    border-radius: 10px;
    background: var(--bg-card-solid);
    border: 1px solid var(--border);
    box-shadow: var(--pg-shadow-icon);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 7px;
  }
  .project-card:hover .float-icon-wrap {
    transform: translateY(-4px) scale(1.1);
    border-color: var(--border-hover);
    box-shadow: var(--pg-shadow-icon-hover);
  }
  .float-icon {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    filter: var(--pg-icon-filter);
  }

  .category-badge {
    position: relative;
    z-index: 1;
    font-size: 0.56rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--text-dim);
    background: var(--pg-accent-soft);
    border: 1px solid var(--pg-accent-line);
    border-radius: 9999px;
    padding: 0.25rem 0.75rem;
  }
  .project-card:hover .category-badge {
    color: var(--text-muted);
    background: var(--pg-accent-soft);
    border-color: var(--pg-accent-line-hover);
  }

  .card-bg-img {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    border-radius: inherit;
    filter: var(--pg-card-bg-filter);
    transition: filter 0.55s ease;
  }
  .project-card:hover .card-bg-img {
    filter: var(--pg-card-bg-filter-hover);
  }
  .card-bg-img::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: rgba(255, 255, 255, 0.85);
    transition: background 0.55s ease;
  }
  .project-card:hover .card-bg-img::after {
    background: var(--pg-card-scrim-hover);
  }
  .card-bg-img img {
    position: absolute;
    inset: -10%;
    width: 120%;
    height: 120%;
    object-fit: cover;
    object-position: center;
    filter: var(--pg-card-blur);
    transition: filter 0.55s ease;
  }
  .project-card:hover .card-bg-img img {
    filter: var(--pg-card-blur-hover);
  }
  /* With a cover image the card sits on the scrim, so text needs fixed colours. */
  .project-card.has-bg .project-card-inner {
    background: #ffffff;
  }
  .project-card.has-bg .project-title {
    color: var(--pg-on-scrim-strong);
  }
  .project-card.has-bg .card-desc,
  .project-card.has-bg .category-badge,
  .project-card.has-bg .view-hint {
    color: var(--pg-on-scrim-dim);
  }
  .project-card.has-bg:hover .project-title {
    color: var(--accent);
  }
  .project-card.has-bg:hover .view-hint {
    color: var(--pg-on-scrim-strong);
  }

  .project-footer {
    overflow: hidden;
    border-top: 1px solid var(--border);
    padding: 0.75rem 1.25rem;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    background: var(--pg-footer-bg);
    gap: 0.75rem;
  }
  .project-card:hover .project-footer {
    background: var(--pg-footer-bg-hover);
  }
  .project-card.has-bg .project-footer {
    background: var(--pg-on-scrim-footer);
    border-top-color: var(--pg-on-scrim-border);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }

  .view-hint {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-left: auto;
    position: relative;
    z-index: 1;
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--text-dimmer);
    user-select: none;
  }
  .view-hint-arrow {
    width: 0.8rem;
    height: 0.8rem;
    flex-shrink: 0;
    opacity: 0.5;
  }
  .project-card:hover .view-hint {
    color: var(--accent);
    gap: 0.6rem;
  }
  .project-card:hover .view-hint-arrow {
    transform: translate(3px, -3px);
    opacity: 1;
  }

  /* ---------- modal ---------- */
  .modal-backdrop {
    position: fixed;
    inset: 0;
    z-index: 10000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    background: var(--pg-modal-scrim);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    overflow-y: auto;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.28s ease;
  }
  .modal-backdrop[hidden] {
    display: none !important;
  }
  .modal-backdrop.modal-open {
    opacity: 1;
    pointer-events: auto;
  }
  .modal-backdrop.modal-closing {
    opacity: 0;
    pointer-events: none;
  }

  .modal-container {
    position: relative;
    display: flex;
    flex-direction: column;
    /* Wide enough that figures are readable rather than letterboxed. */
    width: 100%;
    max-width: min(78rem, 100%);
    max-height: 92vh;
    background: var(--bg-overlay);
    border: 1px solid var(--border);
    border-radius: 1.25rem;
