---
import personalData from '../data/personal.json';

const p = personalData as unknown as Record<string, string | undefined>;

/** Facts are pushed from personal.json so no row renders when an optional field is absent. */
type Fact = { label: string; value: string; href?: string };
const facts: Fact[] = [];
const addFact = (label: string, value?: string, href?: string) => {
  if (value) facts.push({ label, value, href });
};

addFact('Role', p.title);
addFact('Location', p.location);
if (p.yearsExperience) addFact('Experience', `${p.yearsExperience} years`);
addFact('Education', p.education);
addFact('Volunteer', p.volunteer);
if (p.portfolioUrl)
  addFact('Portfolio', p.portfolioUrl.replace(/^https?:\/\//, ''), p.portfolioUrl);
---

<section id="about" class="py-24" style="scroll-margin-top: 80px;">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="about-shell">
      <div class="about-head reveal">
        <p class="about-eyebrow">Get to know me</p>
        <h2 class="section-title about-heading">About Me</h2>
      </div>

      <article class="card about-card reveal">
        <p class="about-prose">{p.aboutLong}</p>

        <hr class="about-rule" />

        <dl class="about-facts">
          {
            facts.map((fact) => (
              <div class="about-fact">
                <dt class="about-fact-label">{fact.label}</dt>
                <dd class="about-fact-value">
                  {fact.href ? (
                    <a href={fact.href} target="_blank" rel="noopener" class="about-fact-link">
                      {fact.value}
                    </a>
                  ) : (
                    fact.value
                  )}
                </dd>
              </div>
            ))
          }
        </dl>
      </article>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll('#about .reveal').forEach((el) => {
    const io = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          el.classList.add('visible');
          io.disconnect();
        }
      },
      { threshold: 0.1 }
    );
    io.observe(el);
  });
</script>

<style>
  .about-shell {
    max-width: 46rem;
    margin-inline: auto;
  }

  .about-head {
    text-align: center;
    margin-bottom: 3rem;
  }
  .about-eyebrow {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-dim);
    margin-bottom: 0.75rem;
  }
  .about-heading {
    font-size: clamp(1.875rem, 5vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .about-card {
    padding: clamp(1.75rem, 4vw, 2.75rem);
  }

  /* One typographic column: the paragraph is the point, not the chrome. */
  .about-prose {
    font-size: clamp(1.05rem, 1.9vw, 1.175rem);
    line-height: 1.75;
    color: var(--text-muted);
    text-wrap: pretty;
  }

  .about-rule {
    height: 1px;
    border: none;
    margin: 2.25rem 0;
    background: var(--border);
  }

  /* Label/value pairs read as a definition list rather than a pile of icon cards. */
  .about-facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 1.5rem 2.5rem;
    margin: 0;
  }
  .about-fact {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
  }
  .about-fact-label {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--text-dimmer);
  }
  .about-fact-value {
    margin: 0;
    font-size: 1rem;
    line-height: 1.5;
    color: var(--text);
    text-wrap: pretty;
  }
  .about-fact-link {
    color: inherit;
    text-decoration-color: var(--pg-accent-line-hover);
    text-underline-offset: 0.2em;
    transition: color 0.2s ease;
  }
  .about-fact-link:hover {
    color: var(--accent);
  }
</style>