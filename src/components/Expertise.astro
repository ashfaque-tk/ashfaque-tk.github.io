---
import expertiseFile from '../data/expertise.json';
import { icons } from '../lib/icons';

type ExpertiseItem = {
  key: string;
  icon?: string;
  iconifyIcon?: string;
  title: string;
  description: string;
};

const expertiseData = expertiseFile.items as ExpertiseItem[];
---

<section id="expertise" class="py-20" style="scroll-margin-top: 80px;">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-14 reveal">
      <p class="text-sm font-semibold tracking-widest text-highlight uppercase mb-3">What I do</p>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold section-title">Expertise</h2>
    </div>

    <div class="expertise-grid max-w-6xl mx-auto">
      {
        expertiseData.map((item, i) => (
          <article class="expertise-card reveal" style={`transition-delay:${i * 0.08}s`}>
            <div class="expertise-icon-wrap" aria-hidden="true">
              {item.iconifyIcon ? (
                <iconify-icon icon={item.iconifyIcon} width="32" height="32" />
              ) : (
                <svg class="expertise-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" set:html={icons[item.icon ?? ''] ?? icons.sparkles} />
              )}
            </div>
            <div class="expertise-copy">

              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<script>
  document.querySelectorAll('#expertise .reveal').forEach((el) => {
    const io = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          el.classList.add('visible');
          io.disconnect();
        }
      },
      { threshold: 0.1 }
    );
    io.observe(el);
  });
</script>

<style>
  .expertise-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.2rem;
  }

  @media (min-width: 768px) {
    .expertise-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .expertise-card {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--ex-card-border);
    border-radius: 1rem;
    background: var(--ex-card-bg);
    transition: transform 0.32s ease, border-color 0.32s ease, box-shadow 0.32s ease;
  }

  .expertise-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 18% 10%, var(--ex-glow-1), transparent 34%),
      radial-gradient(circle at 88% 18%, var(--ex-glow-2), transparent 30%);
    opacity: 0;
    transition: opacity 0.32s ease;
    pointer-events: none;
  }

  .expertise-card:hover {
    transform: translateY(-5px);
    border-color: var(--ex-card-border-hover);
    box-shadow: var(--ex-card-shadow);
  }

  .expertise-card:hover::before {
    opacity: 1;
  }

  .expertise-icon-wrap {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 4rem;
    height: 4rem;
    margin: 1.25rem 1.25rem 0;
    border: 1px solid var(--ex-icon-border);
    border-radius: 1rem;
    background: var(--ex-icon-bg);
    color: var(--ex-icon-color);
    transition: transform 0.32s ease, color 0.32s ease, border-color 0.32s ease;
  }

  .expertise-card:hover .expertise-icon-wrap {
    transform: translateY(-3px) rotate(-4deg);
    border-color: var(--ex-icon-border-hover);
    color: var(--ex-icon-color-hover);
  }

  .expertise-icon {
    width: 2rem;
    height: 2rem;
  }

  .expertise-copy {
    position: relative;
    z-index: 1;
    padding: 1.25rem;
  }

  .expertise-index {
    display: inline-flex;
    margin-bottom: 0.65rem;
    color: var(--accent);
    font-size: 0.68rem;
    font-weight: 900;
    letter-spacing: 0.18em;
  }

  .expertise-copy h3 {
    margin: 0;
    color: var(--text);
    font-size: 1.08rem;
    font-weight: 800;
    line-height: 1.25;
  }

  .expertise-copy p {
    margin: 0.65rem 0 0;
    color: var(--text-muted);
    font-size: 0.88rem;
    line-height: 1.65;
  }
</style>
