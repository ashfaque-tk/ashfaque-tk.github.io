---
import personalData from '../data/personal.json';
import siteData from '../data/site.json';
import menuData from '../data/menu.json';
import { getSocialLinks } from '../lib/socialLinks';

const currentYear = new Date().getFullYear();
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const socialLinks = getSocialLinks(personalData as unknown as Record<string, string | string[]>);

const navLinks = menuData.sections.map((s) => ({ label: s.label, href: s.href }));

// Single source of contact truth: phone, Gmail and LinkedIn only.
const linkedinLink = socialLinks.find((l) => l.label === 'LinkedIn');
const phoneHref = personalData.phoneTel?.trim() || `tel:${personalData.phone.replace(/[^\d+]/g, '')}`;

const contactItems = [
  { label: personalData.phone, href: phoneHref, icon: 'mdi:phone-outline', external: false },
  { label: personalData.email, href: `mailto:${personalData.email}`, icon: 'mdi:gmail', external: false },
  ...(linkedinLink
    ? [{ label: 'LinkedIn', href: linkedinLink.url, icon: linkedinLink.icon, external: true }]
    : []),
];

const { footerAttribution } = siteData;
---

<footer
  id="site-footer"
  style="position: relative; background: var(--footer-bg); border-top: 1px solid var(--footer-border);"
  data-base={base}
>
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-6xl py-14">
    <div class="footer-grid">
      <div class="footer-left">
        <div>
          <p class="text-lg font-bold gradient-text">{personalData.name}</p>
          <p class="text-slate-500 text-xs mt-2 leading-relaxed max-w-[220px]">
            {siteData.tagline}
          </p>
        </div>
      </div>

      <div class="footer-center">
        <nav class="flex flex-col gap-2" aria-label="Footer navigation">
          {
            navLinks.map((link) => (
              <a href={link.href} class="footer-nav-link">
                {link.label}
              </a>
            ))
          }
        </nav>
      </div>

      <div class="footer-right">
        <p class="footer-contact-label">Contact</p>
        <ul class="footer-contact-list">
          {
            contactItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  target={item.external ? '_blank' : undefined}
                  rel={item.external ? 'noopener noreferrer' : undefined}
                  class="footer-contact-link"
                >
                  <iconify-icon icon={item.icon} width="18" height="18" aria-hidden="true" />
                  <span>{item.label}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
    <div class="footer-divider my-8"></div>

    <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-slate-600 text-sm">
        © {currentYear}
        {personalData.name}
        {
          footerAttribution.builder && (
            <>
              {' '}
              · Built by{' '}
              <a href={footerAttribution.builderUrl} target="_blank">
                {footerAttribution.builder}
              </a>
            </>
          )
        }
        {
          footerAttribution.host && (
            <>
              {' '}
              / Hosting by{' '}
              <a href={footerAttribution.hostUrl} target="_blank">
                {footerAttribution.host}
              </a>
            </>
          )
        }
        &nbsp;·&nbsp;<a href={`${base}privacy.html`} class="hover:text-accent transition-colors">Privacy</a 
        >&nbsp;·&nbsp;<a href={`${base}terms.html`} class="hover:text-accent transition-colors">Terms</a> 
      </p>
    </div>
  </div>
</footer>

<style>
  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: start;
  }
  @media (min-width: 768px) {
    .footer-grid {
      grid-template-columns: auto 1fr auto;
      gap: 3rem;
    }
  }

  .footer-left {
    display: flex;
    flex-direction: column;
  }
  .footer-center {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .footer-right {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  @media (min-width: 768px) {
    .footer-right {
      align-items: flex-end;
    }
  }

  @media (max-width: 767px) {
    .footer-center {
      text-align: left;
      align-items: flex-start;
    }
  }

  .footer-nav-link {
    color: #64748b;
    font-size: 0.875rem;
    font-weight: 500;
    transition: color 0.2s ease;
    position: relative;
    display: inline-block;
  }
  .footer-nav-link::after {
    content: '';
    position: absolute;
    bottom: -1px;
    left: 0;
    width: 0;
    height: 1px;
    background: linear-gradient(90deg, #6366f1, #0ea5e9);
    transition: width 0.3s ease;
  }
  .footer-nav-link:hover {
    color: #a5b4fc;
  }
  .footer-nav-link:hover::after {
    width: 100%;
  }

  .footer-email {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: #475569;
    font-size: 0.8rem;
    font-weight: 500;
    transition: color 0.2s ease;
  }
  .footer-email:hover {
    color: #a5b4fc;
  }

  .footer-contact-label {
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #64748b;
    margin-bottom: 0.75rem;
  }
  .footer-contact-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .footer-contact-link {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: #475569;
    font-size: 0.85rem;
    font-weight: 500;
    transition: color 0.2s ease;
  }
  .footer-contact-link:hover {
    color: #a5b4fc;
  }
  .footer-contact-link :global(iconify-icon) {
    flex-shrink: 0;
    opacity: 0.6;
  }
  .footer-contact-link:hover :global(iconify-icon) {
    opacity: 1;
  }

  .footer-divider {
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(99, 102, 241, 0.4) 25%,
      rgba(14, 165, 233, 0.4) 75%,
      transparent 100%
    );
  }

  .footer-social {
    color: #334155;
    display: inline-flex;
    align-items: center;
    transition:
      color 0.2s ease,
      transform 0.2s ease;
  }
  .footer-social:hover {
    color: #a5b4fc;
    transform: translateY(-2px);
  }
</style>
